        task.spawn(function()
            while label and label.Parent and part and part.Parent do
                local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = math.floor((hrp.Position - part.Position).Magnitude)
                    local fruitName = part.Parent and part.Parent.Name or "Fruit"
                    label.Text = "✦ " .. fruitName .. " [" .. dist .. "m]"
                end
                task.wait(0.3)
            end
            if folder then folder:Destroy() end
        end)
    end

    task.spawn(function()
        while true do
            if getgenv().FruitESP then
                for _, obj in pairs(workspace:GetChildren()) do
                    pcall(function()
                        if obj and obj.Parent and (obj:IsA("Tool") or string.find(obj.Name, "Fruit")) then
                            local handle = obj:FindFirstChild("Handle")
                            if handle and not handle:FindFirstChild("VOID_ESP") then
                                AddESP(handle)
                            end
                        end
                    end)
                end
            end
            task.wait(1)
        end
    end)

    local function FindFruits()
        local fruits = {}
        for _, obj in pairs(workspace:GetChildren()) do
            if obj and obj.Parent then
                local isTool = obj:IsA("Tool")
                local hasFruitName = string.find(obj.Name, "Fruit")
                local hasHandle = obj:FindFirstChild("Handle")
               
                if (isTool or hasFruitName) and hasHandle then
                    table.insert(fruits, obj)
                end
            end
        end
        return fruits
    end

    local function GetInventoryFruit()
        for _, container in pairs({Player.Character, Player.Backpack}) do
            if container then
                for _, tool in pairs(container:GetChildren()) do
                    if tool:IsA("Tool") and tool:FindFirstChild("Fruit") then
                        return tool
                    end
                end
            end
        end
        return nil
    end

    local function StoreFruit(fruitTool)
        local fruitName = fruitTool.Name
        local fruitData = FRUIT_DATA[fruitName]
        local fruitId = fruitData and fruitData.id or fruitName:gsub(" Fruit", ""):gsub(" ", "-") .. "-" .. fruitName:gsub(" Fruit", ""):gsub(" ", "-")
       
        for attempt = 1, getgenv().StoreRetries do
            local success, result = pcall(function()
                return CommF:InvokeServer("StoreFruit", fruitId, fruitTool)
            end)
           
            if success and result == true then
                AddLog("📦 Stored: " .. fruitName .. " ✓", Color3.fromRGB(180, 100, 255))
                return true
            end
            task.wait(1)
        end
       
        AddLog("❌ Failed to store: " .. fruitName, Color3.fromRGB(255, 80, 80))
        return false
    end

    local function CollectFruit(fruit)
        if not fruit or not fruit.Parent then return false end
       
        local handle = fruit:FindFirstChild("Handle")
        if not handle then return false end
       
        local fruitName = fruit.Name
        local fruitData = FRUIT_DATA[fruitName] or { rarity = "Unknown", value = "?" }
       
        AddLog("🎯 Target: " .. fruitName .. " [" .. (fruitData.rarity or "Unknown") .. "]", Color3.fromRGB(255, 150, 255))
        ServerStatus.Text = "🍎 SNIPING..."
       
        TweenToPosition(CFrame.new(handle.Position + Vector3.new(0, 8, 0)))
        task.wait(0.3)
       
        TweenToPosition(handle.CFrame)
        task.wait(0.5)
       
        local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            for i = 1, 10 do
                if not fruit.Parent then break end
                hrp.CFrame = handle.CFrame
                farmingPlatform.CFrame = handle.CFrame
                task.wait(0.15)
            end
        end
       
        task.wait(1)
       
        local collected = GetInventoryFruit()
        if collected then
            fruitGrabbedCount = fruitGrabbedCount + 1
            FruitCountLabel.Text = "🍎 FRUITS: " .. fruitGrabbedCount
            StatsLabel.Text = "🔄 " .. hopCount .. " | 🍎 " .. fruitGrabbedCount
            AddLog("✨ SUCCESS! Grabbed: " .. collected.Name, Color3.fromRGB(100, 255, 200))
            StoreFruit(collected)
            return true
        end
       
        AddLog("⚠️ Failed to collect fruit", Color3.fromRGB(255, 180, 0))
        return false
    end

    local function ServerHop()
        if not autoHopEnabled or not getgenv().AutoHop then
            return
        end
       
        hopCount = hopCount + 1
        HopCountLabel.Text = "🔄 HOPS: " .. hopCount
        StatsLabel.Text = "🔄 " .. hopCount .. " | 🍎 " .. fruitGrabbedCount
        ServerStatus.Text = "🚀 HOPPING..."
       
        AddLog("🌐 Searching for servers...", Color3.fromRGB(180, 100, 255))
       
        local success, response = pcall(function()
            return game:HttpGet(API_URL)
        end)
       
        local targetServer = nil
       
        if success then
            local data = HttpService:JSONDecode(response)
           
            if data and data.servers then
                local goodServers = {}
                for _, s in ipairs(data.servers) do
                    if s.players and s.players < 12 and s.players > 0 then
                        table.insert(goodServers, s)
                    end
                end
               
                if #goodServers > 0 then
                    table.sort(goodServers, function(a, b) return a.players < b.players end)
                    targetServer = goodServers[1]
                    AddLog("🎯 Found server: " .. targetServer.players .. " players", Color3.fromRGB(100, 255, 200))
                elseif data.servers[1] then
                    targetServer = data.servers[1]
                    AddLog("⚠️ Using random server: " .. targetServer.players .. " players", Color3.fromRGB(255, 200, 100))
                end
            end
        else
            AddLog("⚠️ API failed, using fallback", Color3.fromRGB(255, 200, 100))
        end
       
        if not targetServer then
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?limit=50"
            local fbSuccess, fbResponse = pcall(function()
                return game:HttpGet(url)
            end)
           
            if fbSuccess then
                local fbData = HttpService:JSONDecode(fbResponse)
                if fbData and fbData.data then
                    local best = nil
                    for _, server in ipairs(fbData.data) do
                        if server.playing and server.playing < server.maxPlayers and server.playing > 0 then
                            if not best or server.playing < best.playing then
                                best = server
                            end
                        end
                    end
                    if best then
                        targetServer = {jobId = best.id, players = best.playing}
                        AddLog("📡 Fallback found: " .. best.playing .. " players", Color3.fromRGB(100, 255, 200))
                    end
                end
            end
        end
       
        if targetServer then
            isFarming = false
            ServerStatus.Text = "✨ TELEPORTING..."
            AddLog("✨ HOPPING to new server...", Color3.fromRGB(180, 100, 255))
            task.wait(0.5)
            TeleportService:TeleportToPlaceInstance(2753915549, targetServer.jobId)
        else
            AddLog("❌ No servers available", Color3.fromRGB(255, 80, 80))
            ServerStatus.Text = "❌ NO SERVER"
        end
    end

    AddLog("━━━━━━━━━━━━━━━━━━━━━━━━━━", Color3.fromRGB(180, 100, 255))
    AddLog("⚡ VOID FRUIT HOPPER v3.0", Color3.fromRGB(200, 150, 255))
    AddLog("🔑 Access: GRANTED", Color3.fromRGB(180, 100, 255))
    AddLog("━━━━━━━━━━━━━━━━━━━━━━━━━━", Color3.fromRGB(180, 100, 255))
    AddLog("✅ System Ready", Color3.fromRGB(100, 255, 200))

    task.spawn(function()
        task.wait(3)
        if not Player.Team or Player.Team.Name == "Choosing" then
            AddLog("⚔️ Joining Marines...", Color3.fromRGB(255, 200, 100))
            pcall(function() CommF:InvokeServer("SetTeam", "Marines") end)
            task.wait(2)
        end
        local team = Player.Team and Player.Team.Name or "None"
        TeamLabel.Text = "⚔️ TEAM: " .. team
        AddLog("✅ Team: " .. team, Color3.fromRGB(100, 255, 200))
    end)

    task.spawn(function()
        while true do
            task.wait(75)
            if autoHopEnabled and getgenv().AutoHop then
                ServerHop()
            end
        end
    end)

    task.spawn(function()
        while true do
            task.wait(getgenv().ScanInterval)
           
            if not getgenv().AutoFruitSniper then
                ServerStatus.Text = "⏸️ SNIPE OFF"
                task.wait(1)
            end
           
            if not Player.Character or not Player.Character:FindFirstChild("HumanoidRootPart") then
                task.wait(2)
            end
           
            ServerStatus.Text = "🔍 SCANNING..."
           
            local fruits = FindFruits()
           
            if #fruits == 0 then
                ServerStatus.Text = "❌ NO FRUIT"
            end
           
            AddLog("🎯 Found " .. #fruits .. " fruit(s)!", Color3.fromRGB(180, 100, 255))
           
            for _, fruit in ipairs(fruits) do
                if fruit and fruit.Parent then
                    local collected = CollectFruit(fruit)
                    if collected then
                        AddLog("✅ Collection complete!", Color3.fromRGB(100, 255, 200))
                    end
                    task.wait(1)
                end
            end
           
            isFarming = false
            AddLog("⏳ Waiting 3s...", Color3.fromRGB(255, 200, 100))
            task.wait(3)
        end
    end)

    task.spawn(function()
        while true do
            if not getgenv().AutoFruitSniper then
                ServerStatus.Text = "⏸️ SNIPE OFF"
            elseif ServerStatus.Text ~= "🚀 HOPPING..." and ServerStatus.Text ~= "✨ TELEPORTING..." and ServerStatus.Text ~= "🍎 SNIPING..." then
                ServerStatus.Text = "🎮 READY"
            end
            task.wait(3)
        end
    end)

    task.spawn(function()
        while true do
            pcall(function()
                local data = Player:FindFirstChild("Data")
                if data then
                    local level = data:FindFirstChild("Level")
                    if level then
                        LevelLabel.Text = "✦ LVL: " .. level.Value
                    end
                end
            end)
            task.wait(5)
        end
    end)

    AddLog("✅ VOID FRUIT HOPPER READY", Color3.fromRGB(100, 255, 200))
    AddLog("🎯 Auto-snipe: ON | Auto-hop: ON", Color3.fromRGB(180, 100, 255))

    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.F7 then
            ScreenGui.Enabled = not ScreenGui.Enabled
            AddLog("UI " .. (ScreenGui.Enabled and "SHOWN" or "HIDDEN"), Color3.fromRGB(255, 200, 100))
        end
    end)

    print("========================================")
    print("⚡ VOID FRUIT HOPPER v3.0")
    print("🔑 Access: GRANTED")
    print("========================================")
    print("Press F7 to toggle UI")
    print("========================================")
end

