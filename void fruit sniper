        label.TextSize = 11
        label.TextStrokeTransparency = 0.2
       
        local glow = Instance.new("Part", part)
        glow.Size = Vector3.new(3.5, 0.3, 3.5)
        glow.Position = part.Position + Vector3.new(0, -0.5, 0)
        glow.Anchored = true
        glow.CanCollide = false
        glow.Transparency = 0.3
        glow.Color = Color3.fromRGB(200, 0, 255)
        glow.Material = Enum.Material.Neon
