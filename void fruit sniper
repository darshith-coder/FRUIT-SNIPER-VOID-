-- ===== KEY VALIDATION =====
local function ValidateKey(key)
    key = string.upper(string.gsub(key, "%s+", ""))
    if string.len(key) ~= 19 then
        return false, "Invalid format! Use: ABCD-EFGH-IJKL-MNOP"
    end
    if string.sub(key, 5, 5) ~= "-" or string.sub(key, 10, 10) ~= "-" or string.sub(key, 15, 15) ~= "-" then
        return false, "Invalid format! Use: ABCD-EFGH-IJKL-MNOP"
    end
    local validChars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-"
    for i = 1, string.len(key) do
        if not string.find(validChars, string.sub(key, i, i)) then
            return false, "Invalid characters in key!"
        end
    end
    return true, "✅ Key validated successfully!"
end

